{
  "name": "@inngest/use-agent",
  "version": "0.4.0",
  "description": "React hooks for building AI chat interfaces with AgentKit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsc && tsup"
  },
  "keywords": [
    "react",
    "hooks",
    "ai",
    "chat",
    "agents",
    "agentkit",
    "inngest",
    "real-time",
    "streaming"
  ],
  "author": "Inngest Inc. <hello@inngest.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inngest/agent-kit.git",
    "directory": "packages/use-agent"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "uuid": ">=9.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.9.1",
    "@types/react": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inngest/realtime": "^0.4.7",
    "@tanstack/react-query": "^5.87.4"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "uuid@>=11.0.0 <11.1.1": "11.1.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
